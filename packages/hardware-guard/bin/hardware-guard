#!/usr/bin/env python3
"""The door `devmachine run --package hardware-guard` opens onto the guard."""
import os
import sys

COMMANDS = ("status", "check", "notify-test")


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print("usage: hardware-guard {%s}" % ",".join(COMMANDS), file=sys.stderr)
        return 2
    script = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "files", "hardware-guard")
    os.execv(sys.executable, [sys.executable, script, *argv])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
