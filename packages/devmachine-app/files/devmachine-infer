#!/usr/bin/env python3
"""devmachine-infer: coding-agent session transcript -> context-panel JSON.

Usage:
    devmachine-infer --session <tmux-session> [--project DIR] [--no-resolve]

Deterministic and LLM-free. Resolves the tmux session's cwd, finds the
transcript of the harness running there (Claude Code, Codex, Pi, opencode,
Kimi Code, Cline or Antigravity), extracts PR/Linear/plan/todo references,
optionally resolves live GitHub state via `gh`, and prints one JSON document
(the context-panel schema).

Vendored (verbatim, adapted only in return shape where noted) from the
eoq-live engine at
plugins/devmachine-dev/skills/eoq-live/scripts/collect.py — kept as a
self-contained copy here because that plugin's install path changes with
version and this script must not depend on it.
"""
from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import re
import sqlite3
import subprocess
import time
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import NamedTuple

PROJECTS_DIR = Path.home() / ".claude" / "projects"
CODEX_SESSIONS_DIR = Path.home() / ".codex" / "sessions"
PI_SESSIONS_DIR = Path.home() / ".pi" / "agent" / "sessions"
# opencode follows XDG on macOS too, never ~/Library.
OPENCODE_DATA_DIR = Path(os.environ.get("XDG_DATA_HOME")
                         or Path.home() / ".local" / "share") / "opencode"
KIMI_HOME = Path(os.environ.get("KIMI_CODE_HOME") or Path.home() / ".kimi-code")
_CLINE_DATA = Path(os.environ.get("CLINE_DATA_DIR")
                   or Path(os.environ.get("CLINE_DIR") or Path.home() / ".cline") / "data")
CLINE_SESSIONS_DIR = Path(os.environ.get("CLINE_SESSION_DATA_DIR") or _CLINE_DATA / "sessions")
CLINE_DB_PATH = Path(os.environ.get("CLINE_DB_DATA_DIR") or _CLINE_DATA / "db") / "sessions.db"
ANTIGRAVITY_DIR = Path.home() / ".gemini" / "antigravity-cli"

HARNESSES = ("claude", "codex", "pi", "opencode", "kimi", "cline", "antigravity")

CONFIG_PATH_SHARED = Path("/etc/devmachine-app/config.json")
CONFIG_PATH_MACOS = Path.home() / ".config" / "devmachine-app" / "config.json"


def config_path() -> Path:
    override = os.environ.get("DEVMACHINE_APP_CONFIG")
    if override:
        return Path(override)
    # A Mac reached over SSH gets the shared file, like Linux, so every
    # workspace account reads it. Only your own Mac, synced without root,
    # keeps it in the home.
    if platform.system() == "Darwin" and not CONFIG_PATH_SHARED.exists():
        return CONFIG_PATH_MACOS
    return CONFIG_PATH_SHARED


def load_config() -> dict:
    try:
        return json.loads(config_path().read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def github_hosts() -> list[dict]:
    """The GitHub Enterprise hosts a PR reference may name, beyond github.com.

    Each entry is `{"host": ..., "proxy": ...}`; `proxy` may be empty. Missing
    or empty configuration means github.com is the only host anyone resolves.
    """
    hosts = load_config().get("github_hosts")
    return hosts if isinstance(hosts, list) else []


def _gh_host_pattern() -> str:
    hosts = ["github.com"] + [h["host"] for h in github_hosts() if h.get("host")]
    return "|".join(re.escape(h) for h in hosts)


def gh_pr_url_re() -> re.Pattern:
    """Built fresh from the configured hosts: the config can change between calls in tests."""
    return re.compile(r"(" + _gh_host_pattern() + r")/([\w.-]+/[\w.-]+)/(?:pull|issues)/(\d+)")


URL_RE = re.compile(r"https?://[^\s\"'<>)\\\]]+")
# An issue key in the URL path — Linear (`/issue/ABC-123`), Jira (`/browse/ABC-123`)
# and anything else that numbers issues the same way. No tracker is named here.
ISSUE_KEY_RE = re.compile(r"/([A-Z][A-Z0-9]{1,9}-\d+)(?=[/?#]|$)")
# A `gh pr`/`gh issue` command names its number without a URL — but only the
# subcommands that act on ONE of them. `gh pr list --limit 15` names no PR, and
# reading the first number of the command turned `--interval 15` into PR #15.
GH_CMD_RE = re.compile(r"\bgh\s+(?:pr|issue)\s+"
                       r"(view|checks|merge|comment|diff|edit|close|reopen|ready|review)"
                       r"((?:\s+[^\s\"';|&]+)*)")
GH_CMD_REPO_RE = re.compile(r"(?:-R|--repo)[=\s]+([\w.-]+/[\w.-]+)")

NOISE_EXT = (".svg", ".png", ".ico", ".gif", ".css", ".js", ".woff", ".woff2")
NOISE_HOST_PREFIX = ("static.", "cdn.", "assets.")
TASK_DONE_RE = re.compile(r"<task-id>([^<]+)</task-id>")
# Claude's native binary is installed under its version number, so tmux names
# the pane's command `2.1.284` rather than `claude`.
VERSION_RE = re.compile(r"\d+\.\d+\.\d+")
CODEX_DONE_MARK = "Message Type: FINAL_ANSWER"


def run(cmd, env=None, timeout=30):
    """Run a command, return (ok, stdout). Never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout,
                           shell=isinstance(cmd, str), env=env)
        return p.returncode == 0, p.stdout.strip() or p.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)


def pr_number(args: str) -> str | None:
    """The PR/issue number in a `gh` command, or None.

    `gh` takes it as the first argument, so only that one counts. Reading any
    number of the command turned `--interval 15` into PR #15 and the `2>` of a
    redirection into PR #2 — and no flag list tells a boolean flag from one
    that eats the next token, so anything after a flag is not trusted.
    """
    first = args.split()[:1]
    return first[0] if first and first[0].isdigit() else None


# ── transcript ────────────────────────────────────────────────────────────

def claude_slug(path: Path) -> str:
    """The folder Claude Code keeps a project's transcripts in.

    Every character that is not an ASCII letter or digit becomes `-`, so
    `/home/alice/.config` is `-home-alice--config`. Replacing only `/` missed
    every path with a dot, an underscore or a space.
    """
    return re.sub(r"[^A-Za-z0-9]", "-", str(path))


def find_transcript(session: str, project: Path) -> Path | None:
    slug = claude_slug(project.resolve())
    d = PROJECTS_DIR / slug
    if session != "auto":
        for f in d.glob(f"{session}*.jsonl"):
            return f
        # Session id may belong to another project — search all slugs.
        for f in PROJECTS_DIR.glob(f"*/{session}*.jsonl"):
            return f
        return None
    files = recent_transcripts(project, limit=1)
    return files[0] if files else None


def recent_transcripts(project: Path, limit: int = 4, max_age_h: float = 12) -> list[Path]:
    """The project's transcripts, newest first: the open sessions of this repo.

    The session with the task list and the session that touched a PR are often
    different files (a worktree writes to its own slug), so the panel reads the
    newest for the plan and all of them for the references.
    """
    slug = claude_slug(project.resolve())
    files = [f for sub in project_dirs(slug) for f in sub.glob("*.jsonl")]
    files.sort(key=lambda f: f.stat().st_mtime, reverse=True)
    floor = time.time() - max_age_h * 3600
    fresh = [f for f in files if f.stat().st_mtime >= floor]
    return (fresh or files[:1])[:limit]


def project_dirs(slug: str):
    """The project's transcript dir, plus the dirs of projects under it.

    A session that moves into a git worktree (`.claude/worktrees/<branch>`)
    writes to another slug, while the tmux pane stays in the repository root.
    """
    yield PROJECTS_DIR / slug
    for d in sorted(PROJECTS_DIR.glob(f"{slug}-*")):
        if d.is_dir():
            yield d


def _codex_session_cwd(path: Path) -> str | None:
    """The `cwd` a Codex rollout recorded for itself, read from its first line.

    Codex, unlike Claude, does not sort its transcripts into a per-project
    directory — every rollout lives under `sessions/YYYY/MM/DD/`, and the
    project it belongs to is only known from the `session_meta` event each
    rollout opens with.
    """
    try:
        with open(path, errors="replace") as fh:
            first = fh.readline()
        d = json.loads(first)
    except (OSError, json.JSONDecodeError):
        return None
    payload = d.get("payload") if isinstance(d, dict) else None
    cwd = payload.get("cwd") if isinstance(payload, dict) else None
    return cwd if isinstance(cwd, str) else None


def recent_codex_transcripts(project: Path, limit: int = 4, max_age_h: float = 12) -> list[Path]:
    """Same answer as `recent_transcripts`, found newest first so that only a
    handful of first lines are read: the panel polls every 5s, and reading
    every rollout Codex ever wrote grows with the history, not the project.
    """
    target = str(project.resolve())
    floor = time.time() - max_age_h * 3600
    dated = sorted(((f.stat().st_mtime, f)
                    for f in CODEX_SESSIONS_DIR.glob("*/*/*/rollout-*.jsonl")), reverse=True)
    found: list[Path] = []
    for mtime, f in dated:
        if mtime < floor and found:
            break
        if _codex_session_cwd(f) != target:
            continue
        found.append(f)
        if mtime < floor or len(found) >= limit:
            break
    return found


def find_codex_transcript(project: Path) -> Path | None:
    files = recent_codex_transcripts(project, limit=1)
    return files[0] if files else None


def pi_project_slug(path: Path) -> str:
    """Pi's session directory name for a project's cwd.

    Pi wraps the resolved path in a leading and trailing `/` before turning
    every `/` into `-`, so the wrapper separators and the path's own become
    indistinguishable — `/Users/a/b` slugifies to `--Users-a-b--`, not
    `-Users-a-b-`.
    """
    resolved = str(path.resolve())
    return "-" + (resolved + "/").replace("/", "-") + "-"


def recent_pi_transcripts(project: Path, limit: int = 4, max_age_h: float = 12) -> list[Path]:
    d = PI_SESSIONS_DIR / pi_project_slug(project)
    files = list(d.glob("*.jsonl")) if d.is_dir() else []
    files.sort(key=lambda f: f.stat().st_mtime, reverse=True)
    floor = time.time() - max_age_h * 3600
    fresh = [f for f in files if f.stat().st_mtime >= floor]
    return (fresh or files[:1])[:limit]


def find_pi_transcript(project: Path) -> Path | None:
    files = recent_pi_transcripts(project, limit=1)
    return files[0] if files else None


def _cwd_forms(project: Path) -> list[str]:
    """The project's path as a harness may have stored it: as given, and with
    its symlinks resolved. These harnesses record the cwd itself, not a slug."""
    return sorted({os.path.abspath(str(project)), str(project.resolve())})


def _mtime(path: Path) -> float | None:
    try:
        return path.stat().st_mtime
    except OSError:
        return None


def _newest_first(dated: list, limit: int, max_age_h: float) -> list:
    """The items of `(mtime, item)` pairs, newest first: those touched within
    `max_age_h`, or else the newest one alone — the same rule as the others."""
    dated = sorted(dated, key=lambda d: d[0], reverse=True)
    floor = time.time() - max_age_h * 3600
    fresh = [item for mtime, item in dated if mtime >= floor]
    return (fresh or [item for _, item in dated[:1]])[:limit]


class OpencodeSession(NamedTuple):
    """An opencode session: rows in a SQLite database, not a file of its own."""
    db: Path
    id: str
    updated: float


def _open_readonly(db: Path) -> sqlite3.Connection:
    """A connection that can never change the database.

    `mode=ro` still reads what a running writer keeps in the WAL, but on a WAL
    database whose `-wal` is gone it creates `-wal`/`-shm` itself — owned by
    whoever runs this, which can lock the harness out of its own database.
    No `-wal` and no `-journal` means no writer is open, and only then is
    `immutable` safe: it ignores both, and every lock.
    """
    uri = db.absolute().as_uri()
    idle = not any(db.with_name(db.name + s).exists() for s in ("-wal", "-journal"))
    return sqlite3.connect(uri + ("?mode=ro&immutable=1" if idle else "?mode=ro"),
                           uri=True, timeout=2)


def _query(db: Path, sql: str, args=()) -> list | None:
    """Every row, or None when the database cannot be read at all."""
    try:
        con = _open_readonly(db)
        try:
            return con.execute(sql, args).fetchall()
        finally:
            con.close()
    except (sqlite3.Error, OSError, ValueError):
        return None


def opencode_databases() -> list[Path]:
    """`OPENCODE_DB` when set (absolute, or a name in the data dir), else every
    channel's database: public releases write `opencode.db`, others
    `opencode-<channel>.db`."""
    override = os.environ.get("OPENCODE_DB")
    if override:
        p = Path(override)
        return [p if p.is_absolute() else OPENCODE_DATA_DIR / p]
    return sorted(OPENCODE_DATA_DIR.glob("opencode*.db"))


def recent_opencode_transcripts(project: Path, limit: int = 4,
                                max_age_h: float = 12) -> list[OpencodeSession]:
    """The project's top-level opencode sessions. A subagent's session has a
    `parent_id` and the same directory, and belongs to its parent."""
    forms = _cwd_forms(project)
    marks = ",".join("?" * len(forms))
    dated = []
    for db in opencode_databases():
        rows = _query(db, f"SELECT id, time_updated FROM session WHERE directory IN ({marks})"
                          " AND parent_id IS NULL AND time_archived IS NULL"
                          " ORDER BY time_updated DESC LIMIT 20", forms) or []
        for sid, updated in rows:
            if isinstance(sid, str) and isinstance(updated, (int, float)):
                dated.append((updated / 1000, OpencodeSession(db, sid, updated / 1000)))
    return _newest_first(dated, limit, max_age_h)


def find_opencode_transcript(project: Path) -> OpencodeSession | None:
    found = recent_opencode_transcripts(project, limit=1)
    return found[0] if found else None


def kimi_workdir_key(work_dir: str) -> str:
    """Kimi Code's folder name for a cwd: a slug of the last path component and
    a hash of the whole path, as `ac2/_base/utils/workdir-slug.ts` builds it."""
    normalized = re.sub(r"/+$", "", work_dir.replace("\\", "/"))
    slug = re.sub(r"[^a-z0-9._-]+", "-", normalized.split("/")[-1].lower())
    slug = re.sub(r"^-+|-+$", "", re.sub(r"^-+|-+$", "", slug)[:40])
    if slug in ("", ".", ".."):
        slug = "workspace"
    return f"wd_{slug}_{hashlib.sha256(normalized.encode('utf-8')).hexdigest()[:12]}"


def recent_kimi_transcripts(project: Path, limit: int = 4, max_age_h: float = 12) -> list[Path]:
    """The main agent's wire of each of the project's Kimi sessions.

    `session_index.jsonl` comes first: a workspace migrated from the older
    kimi-cli keeps its old folder, which the computed key would miss.
    """
    forms = _cwd_forms(project)
    dirs, deleted = {}, set()
    try:
        for d in iter_events(KIMI_HOME / "session_index.jsonl"):
            sid = d.get("sessionId")
            if not isinstance(sid, str):
                continue
            if d.get("deleted"):
                deleted.add(sid)
            elif d.get("workDir") in forms and isinstance(d.get("sessionDir"), str):
                dirs[sid] = Path(d["sessionDir"])
    except OSError:
        pass
    for form in forms:
        for d in (KIMI_HOME / "sessions" / kimi_workdir_key(form)).glob("session_*"):
            dirs.setdefault(d.name, d)
    dated = []
    for sid, d in dirs.items():
        wire = d / "agents" / "main" / "wire.jsonl"
        mtime = None if sid in deleted else _mtime(wire)
        if mtime is not None:
            dated.append((mtime, wire))
    return _newest_first(dated, limit, max_age_h)


def find_kimi_transcript(project: Path) -> Path | None:
    files = recent_kimi_transcripts(project, limit=1)
    return files[0] if files else None


def _cline_manifest_rows(forms: list[str]) -> list[tuple]:
    """What the session index would answer, read from each session's manifest
    (`sessions/<id>/<id>.json`) — Cline itself does this when SQLite fails."""
    rows = []
    for f in CLINE_SESSIONS_DIR.glob("*/*.json"):
        if f.stem != f.parent.name:
            continue
        try:
            manifest = json.loads(f.read_text(errors="replace"))
        except (OSError, ValueError):
            continue
        if not isinstance(manifest, dict):
            continue
        if manifest.get("cwd") in forms or manifest.get("workspace_root") in forms:
            rows.append((f.parent.name, manifest.get("messages_path")))
    return rows


def recent_cline_transcripts(project: Path, limit: int = 4, max_age_h: float = 12) -> list[Path]:
    """The messages file of each of the project's top-level Cline sessions.

    A session matches on its cwd or its git root, as Cline's own list does. A
    subagent is a row of its own (`is_subagent`), filed under its parent.
    """
    forms = _cwd_forms(project)
    marks = ",".join("?" * len(forms))
    rows = _query(CLINE_DB_PATH,
                  f"SELECT session_id, messages_path FROM sessions"
                  f" WHERE (cwd IN ({marks}) OR workspace_root IN ({marks}))"
                  " AND is_subagent = 0 AND (parent_session_id IS NULL OR parent_session_id = '')"
                  " ORDER BY started_at DESC LIMIT 20", forms + forms)
    if rows is None:
        rows = _cline_manifest_rows(forms)
    dated = []
    for sid, stored in rows:
        if not isinstance(sid, str):
            continue
        for path in ([Path(stored)] if isinstance(stored, str) and stored else []) + [
                CLINE_SESSIONS_DIR / sid / f"{sid}.messages.json"]:
            mtime = _mtime(path)
            if mtime is not None:
                dated.append((mtime, path))
                break
    return _newest_first(dated, limit, max_age_h)


def find_cline_transcript(project: Path) -> Path | None:
    files = recent_cline_transcripts(project, limit=1)
    return files[0] if files else None


def recent_antigravity_transcripts(project: Path, limit: int = 4,
                                   max_age_h: float = 12) -> list[Path]:
    """The transcript of each Antigravity conversation started in the project.

    Every conversation lives flat under `brain/<id>/`, and its transcript names
    no workspace: the only link from a cwd to a conversation is the prompt log,
    `history.jsonl`, whose lines carry both. Its format is undocumented, so
    any line that does not read as expected is skipped.
    """
    forms = _cwd_forms(project)
    ids = []
    try:
        for d in iter_events(ANTIGRAVITY_DIR / "history.jsonl"):
            cid = d.get("conversationId")
            if (d.get("workspace") in forms and isinstance(cid, str)
                    and re.fullmatch(r"[\w-]+", cid)):
                ids.append(cid)
    except OSError:
        pass
    dated = []
    for cid in dict.fromkeys(ids):
        logs = ANTIGRAVITY_DIR / "brain" / cid / ".system_generated" / "logs"
        for name in ("transcript_full.jsonl", "transcript.jsonl"):
            mtime = _mtime(logs / name)
            if mtime is not None:
                dated.append((mtime, logs / name))
                break
    return _newest_first(dated, limit, max_age_h)


def find_antigravity_transcript(project: Path) -> Path | None:
    files = recent_antigravity_transcripts(project, limit=1)
    return files[0] if files else None


def iter_events(path: Path):
    """Yield parsed transcript lines; skip malformed ones (partial writes)."""
    with open(path, errors="replace") as fh:
        for line in fh:
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if isinstance(event, dict):
                yield event


def _iso_ms(ms) -> str:
    """An epoch-milliseconds stamp in the ISO form the other harnesses write."""
    if not isinstance(ms, (int, float)) or isinstance(ms, bool):
        return ""
    try:
        moment = datetime.fromtimestamp(ms / 1000, tz=timezone.utc)
    except (OverflowError, OSError, ValueError):
        return ""
    return moment.isoformat(timespec="milliseconds").replace("+00:00", "Z")


def opencode_events(session: OpencodeSession) -> list[dict]:
    """The session's parts in order, each with its message's role, then the
    `todo` table as one last event. The table is read even when empty: an
    empty list there is a cleared checklist, not a missing one."""
    rows = _query(session.db,
                  "SELECT p.time_created, p.time_updated, m.data, p.data"
                  " FROM part p JOIN message m ON m.id = p.message_id"
                  " WHERE p.session_id = ? ORDER BY m.time_created, m.id, p.id",
                  (session.id,)) or []
    events = []
    for created, updated, message, part in rows:
        data = _json_object(part)
        if data:
            events.append({"ts": _iso_ms(created), "updated": _iso_ms(updated),
                           "role": _json_object(message).get("role"), "part": data})
    todos = _query(session.db, "SELECT content, status FROM todo WHERE session_id = ?"
                               " ORDER BY position", (session.id,))
    if todos is not None:
        events.append({"todos": [{"content": c, "status": s} for c, s in todos]})
    return events


def cline_events(path: Path) -> list[dict]:
    """The messages of a Cline session. Cline rewrites the file in place, not
    through a rename, so a read can land on half of it: one retry, then none."""
    for attempt in range(2):
        try:
            data = json.loads(path.read_text(errors="replace"))
            break
        except (OSError, ValueError):
            if attempt:
                return []
            time.sleep(0.05)
    messages = data.get("messages") if isinstance(data, dict) else data
    return [m for m in messages if isinstance(m, dict)] if isinstance(messages, list) else []


def load_events(harness: str, tx) -> list[dict]:
    """A transcript's events, in the harness's own shape. opencode keeps its
    sessions in SQLite and Cline in one JSON document; the rest write JSONL."""
    if harness == "opencode":
        return opencode_events(tx)
    if harness == "cline":
        return cline_events(tx)
    try:
        return list(iter_events(tx))
    except OSError:
        return []


def _instant(ts: str) -> datetime | None:
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except (ValueError, AttributeError):
        return None


def seen_at(entry: dict, ts: str) -> None:
    """Move the entry's last mention forward. An event without a timestamp
    must not erase the time of one that had it, and two stamps are compared as
    instants: the panel reads them that way, and a string compare puts
    `...00Z` above `...00.500Z`."""
    now, kept = _instant(ts), _instant(entry.get("last_ts", ""))
    if now is not None and (kept is None or now > kept):
        entry["last_ts"] = ts


def _claude_ref_blobs(events, touched_md: list):
    for d in events:
        ts = d.get("timestamp") or ""
        msg = d.get("message")
        if not isinstance(msg, dict):
            continue
        content = msg.get("content")
        if isinstance(content, str):
            yield ts, content
        elif isinstance(content, list):
            for b in content:
                if not isinstance(b, dict):
                    continue
                if b.get("type") == "text":
                    yield ts, b.get("text", "")
                elif b.get("type") == "tool_use":
                    inp = b.get("input", {})
                    # File bodies are code, not session references — fixture
                    # URLs/PR numbers inside them would self-contaminate.
                    scan = {k: v for k, v in inp.items()
                            if k not in ("content", "new_string", "old_string")}
                    yield ts, json.dumps(scan, ensure_ascii=False)
                    fp = inp.get("file_path", "")
                    if b.get("name") in ("Write", "Edit") and fp.endswith(".md"):
                        touched_md.append(fp)


def _codex_ref_blobs(events, touched_md: list):
    """Codex writes one transcript line per item: a `message` for chat text,
    and a tool call's request/response as either `custom_tool_call` +
    `custom_tool_call_output` (the exec-tool build seen locally) or
    `function_call` + `function_call_output` (the classic shell-tool build
    documented upstream, not seen locally but kept for forward compatibility).
    """
    for d in events:
        if d.get("type") != "response_item":
            continue
        payload = d.get("payload")
        if not isinstance(payload, dict):
            continue
        ts = d.get("timestamp") or ""
        kind = payload.get("type")
        if kind == "message":
            for c in payload.get("content") or []:
                if isinstance(c, dict) and c.get("type") in ("input_text", "output_text"):
                    text = c.get("text", "")
                    yield ts, text
        elif kind == "custom_tool_call":
            text = payload.get("input", "")
            if isinstance(text, str):
                yield ts, text
        elif kind == "custom_tool_call_output":
            output = payload.get("output")
            if isinstance(output, str):
                yield ts, output
            for c in output if isinstance(output, list) else []:
                if isinstance(c, dict) and isinstance(c.get("text"), str):
                    yield ts, c["text"]
        elif kind in ("function_call", "function_call_output"):
            raw = payload.get("arguments", payload.get("output", ""))
            text = raw if isinstance(raw, str) else json.dumps(raw, ensure_ascii=False)
            yield ts, text


def _pi_ref_blobs(events, touched_md: list):
    """Pi keeps one `message` event per turn, with `content` a list of blocks
    (`text`, `toolCall`) whatever the role — a user turn, an assistant turn, or
    a tool's own result all use the same shape, so one loop reads all three.
    """
    for d in events:
        if d.get("type") != "message":
            continue
        msg = d.get("message")
        if not isinstance(msg, dict):
            continue
        ts = d.get("timestamp") or ""
        content = msg.get("content")
        if not isinstance(content, list):
            continue
        for c in content:
            if not isinstance(c, dict):
                continue
            ctype = c.get("type")
            if ctype == "text":
                text = c.get("text", "")
                yield ts, text
            elif ctype == "toolCall":
                args = c.get("arguments")
                text = args if isinstance(args, str) else json.dumps(args or {}, ensure_ascii=False)
                yield ts, text


# File bodies are code, not session references (see `_claude_ref_blobs`), under
# the names each harness's write and edit tools give them.
_FILE_BODY_KEYS = {"content", "new_string", "old_string", "oldString", "newString",
                   "file_text", "old_str", "new_str", "CodeContent", "ReplacementContent",
                   "TargetContent", "ReplacementChunks"}


def _args_blob(args) -> str:
    args = _json_object(args)
    return json.dumps({k: v for k, v in args.items() if k not in _FILE_BODY_KEYS},
                      ensure_ascii=False)


def _text(value) -> str:
    return value if isinstance(value, str) else ""


def _opencode_ref_blobs(events, touched_md: list):
    """A `text` part is chat text whatever the role; a `tool` part holds the
    call and its result together, in `state.input` and `state.output`."""
    for d in events:
        part = d.get("part")
        if not isinstance(part, dict):
            continue
        ts = d.get("ts") or ""
        if part.get("type") == "text":
            yield ts, _text(part.get("text"))
        elif part.get("type") == "tool":
            state = part.get("state") if isinstance(part.get("state"), dict) else {}
            yield ts, _args_blob(state.get("input"))
            for key in ("output", "error"):
                if isinstance(state.get(key), str):
                    yield ts, state[key]


def _kimi_ref_blobs(events, touched_md: list):
    """A user prompt is a `turn.prompt` record; the model's text, its tool calls
    and their results are loop events. Streaming deltas are never written, so
    each text appears once, whole."""
    for d in events:
        ts = _iso_ms(d.get("time"))
        kind = d.get("type")
        if kind == "turn.prompt":
            prompt = d.get("input")
            for c in prompt if isinstance(prompt, list) else []:
                if isinstance(c, dict) and c.get("type") == "text":
                    yield ts, _text(c.get("text"))
        elif kind == "context.append_loop_event":
            event = d.get("event")
            if not isinstance(event, dict):
                continue
            ekind = event.get("type")
            if ekind == "content.part":
                part = event.get("part")
                if isinstance(part, dict) and part.get("type") == "text":
                    yield ts, _text(part.get("text"))
            elif ekind == "tool.call":
                yield ts, _args_blob(event.get("args"))
            elif ekind == "tool.result":
                result = event.get("result") if isinstance(event.get("result"), dict) else {}
                output = result.get("output")
                if isinstance(output, str):
                    yield ts, output
                for c in output if isinstance(output, list) else []:
                    if isinstance(c, dict):
                        yield ts, _text(c.get("text"))


def _cline_result_texts(content):
    """A tool result is a string, text blocks, or — for `run_commands` — one
    object per command with its `result` or `error`."""
    if isinstance(content, str):
        yield content
    for c in content if isinstance(content, list) else []:
        if isinstance(c, dict):
            for key in ("text", "result", "error"):
                if isinstance(c.get(key), str):
                    yield c[key]


def _cline_ref_blobs(events, touched_md: list):
    """Cline's messages are Anthropic-shaped, and a tool's result is a `user`
    message of its own."""
    for msg in events:
        ts = _iso_ms(msg.get("ts"))
        content = msg.get("content")
        if isinstance(content, str):
            yield ts, content
        for b in content if isinstance(content, list) else []:
            if not isinstance(b, dict):
                continue
            kind = b.get("type")
            if kind == "text":
                yield ts, _text(b.get("text"))
            elif kind == "tool_use":
                yield ts, _args_blob(b.get("input"))
            elif kind == "tool_result":
                for text in _cline_result_texts(b.get("content")):
                    yield ts, text


_AGY_REQUEST_RE = re.compile(r"<USER_REQUEST>\s*(.*?)\s*</USER_REQUEST>", re.S)
_AGY_SKIP = {"CONVERSATION_HISTORY", "CHECKPOINT", "EPHEMERAL_MESSAGE", "SYSTEM_MESSAGE",
             "ERROR_MESSAGE"}


def _antigravity_ref_blobs(events, touched_md: list):
    """One step per line. A user step wraps the request in metadata the user
    never typed, so only `<USER_REQUEST>` counts. A model step is either a
    `PLANNER_RESPONSE` (text and tool calls) or the result of the call before
    it, with the result in `content`."""
    for d in events:
        ts = _text(d.get("created_at"))
        kind = d.get("type")
        content = _text(d.get("content"))
        if kind == "USER_INPUT":
            m = _AGY_REQUEST_RE.search(content)
            yield ts, m.group(1) if m else content
        elif kind in _AGY_SKIP or d.get("source") != "MODEL":
            continue
        else:
            if content:
                yield ts, content
            calls = d.get("tool_calls") if kind == "PLANNER_RESPONSE" else None
            for call in calls if isinstance(calls, list) else []:
                if isinstance(call, dict):
                    yield ts, _args_blob(call.get("args"))


_REF_BLOBS = {"claude": _claude_ref_blobs, "codex": _codex_ref_blobs, "pi": _pi_ref_blobs,
              "opencode": _opencode_ref_blobs, "kimi": _kimi_ref_blobs,
              "cline": _cline_ref_blobs, "antigravity": _antigravity_ref_blobs}


def extract_refs(events, default_repo: str | None, harness: str = "claude"):
    """Chronological scan → (github refs, links, touched md files).

    github: {"repo#num": {"host","repo","num","first_ts","last_ts","count","url"}}
    links:  {url: {"count","last_ts"}}

    The walk from a harness's own event shape to a flat stream of text blobs
    is harness-specific (`_REF_BLOBS`); the regex scan of those blobs for a
    PR, a `gh` command or a plain link is the same for every harness.
    """
    github, links, touched_md = {}, {}, []
    pr_url_re = gh_pr_url_re()
    blob_source = _REF_BLOBS.get(harness, _claude_ref_blobs)
    for ts, blob in blob_source(events, touched_md):
        for m in pr_url_re.finditer(blob):
            host, repo, num = m.group(1), m.group(2), m.group(3)
            key = f"{repo}#{num}"
            e = github.setdefault(key, {"host": host, "repo": repo, "num": int(num),
                                        "first_ts": ts, "last_ts": ts, "count": 0,
                                        "url": f"https://{host}/{repo}/pull/{num}"})
            e["count"] += 1
            seen_at(e, ts)
        for m in GH_CMD_RE.finditer(blob):
            args = m.group(2)
            repo_m = GH_CMD_REPO_RE.search(args)
            repo = repo_m.group(1) if repo_m else default_repo
            if not repo:
                continue
            num = pr_number(GH_CMD_REPO_RE.sub(" ", args) if repo_m else args)
            if not num:
                continue
            key = f"{repo}#{num}"
            e = github.setdefault(key, {"host": "github.com", "repo": repo,
                                        "num": int(num), "first_ts": ts, "last_ts": ts,
                                        "count": 0,
                                        "url": f"https://github.com/{repo}/pull/{num}"})
            e["count"] += 1
            seen_at(e, ts)
        for m in URL_RE.finditer(blob):
            url = m.group(0).rstrip(".,;:`")
            if "{" in url:  # template string, not a real link
                continue
            if pr_url_re.search(url):
                continue
            base = url.split("?")[0]
            host = base.split("/")[2] if "://" in base else ""
            if base.lower().endswith(NOISE_EXT) or host.startswith(NOISE_HOST_PREFIX):
                continue
            e = links.setdefault(base, {"count": 0, "last_ts": ts})
            e["count"] += 1
            e["last_ts"] = ts
    return {"github": github, "links": links, "touched_md": touched_md}


# ── github resolve ────────────────────────────────────────────────────────

def gh_env(host: str):
    if host == "github.com":
        return None
    proxy = next((h.get("proxy") for h in github_hosts() if h.get("host") == host), None)
    env = dict(os.environ, GH_HOST=host)
    if proxy:
        env["HTTPS_PROXY"] = proxy
    return env


# One query answers every pull request of a session, and the answer is kept on
# disk. The panel polls every 5s: asking `gh` per pull request, twice, on every
# poll spent a 5000/hour budget in under half an hour, and every session and
# every host draws on the same one.
CACHE_FILE = Path.home() / ".cache" / "devmachine-infer" / "prs.json"
FRESH_OPEN = 90
FRESH_TERMINAL = 24 * 3600
FRESH_UNKNOWN = 600
RATE_LIMIT_PAUSE = 300
CACHE_KEEP = 7 * 24 * 3600
TERMINAL_STATES = {"merged", "closed"}

_PR_FIELDS = ("number state isDraft title url reviewDecision "
              "reviewThreads(first: 100) { nodes { isResolved } } "
              "commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }")

_ROLLUP = {"SUCCESS": "pass", "FAILURE": "fail", "ERROR": "fail",
           "PENDING": "pending", "EXPECTED": "pending"}


def cache_key(entry: dict) -> str:
    return f"{entry['host']}|{entry['repo']}#{entry['num']}"


def cache_load(path: Path = CACHE_FILE) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError, ValueError):
        return {}


def cache_save(cache: dict, path: Path = CACHE_FILE) -> None:
    """Write through a neighbour file: two polls can land at once, and half a
    JSON document reads as no cache at all."""
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(f".{os.getpid()}.tmp")
        tmp.write_text(json.dumps(cache))
        os.replace(tmp, path)
    except OSError:
        pass


def batch_query(entries: list[dict]) -> str:
    parts = []
    for i, e in enumerate(entries):
        owner, name = e["repo"].split("/", 1)
        parts.append(f"a{i}: repository(owner: {json.dumps(owner)}, name: {json.dumps(name)})"
                     f" {{ pullRequest(number: {int(e['num'])}) {{ {_PR_FIELDS} }} }}")
    return "query {" + " ".join(parts) + "}"


def _rollup_of(node: dict) -> str:
    commits = (node.get("commits") or {}).get("nodes") or []
    if not commits:
        return "none"
    rollup = ((commits[0] or {}).get("commit") or {}).get("statusCheckRollup")
    return _ROLLUP.get((rollup or {}).get("state", ""), "none")


def _unresolved(node: dict) -> int | None:
    nodes = (node.get("reviewThreads") or {}).get("nodes")
    if nodes is None:
        return None
    return sum(1 for t in nodes if not t.get("isResolved"))


def parse_batch(out: str, entries: list[dict]) -> tuple[dict, bool, bool]:
    """(cache key -> what GitHub says, hit the rate limit, GitHub answered).

    A reference the transcript names is not always a pull request GitHub will
    show — an issue number, a repository nobody here can read. That answer is
    an answer, and keeping it is what stops the panel asking again every poll.
    """
    try:
        payload = json.loads(out)
    except json.JSONDecodeError:
        return {}, "rate limit" in out.lower(), False
    errors = payload.get("errors") or []
    limited = any(e.get("type") == "RATE_LIMIT" for e in errors)
    data = payload.get("data") or {}
    resolved = {}
    answered = "data" in payload and not limited
    for i, entry in enumerate(entries):
        node = (data.get(f"a{i}") or {}).get("pullRequest")
        if not node:
            continue
        draft = bool(node.get("isDraft"))
        state = node.get("state", "")
        resolved[cache_key(entry)] = {
            "title": node.get("title", ""),
            "url": node.get("url") or entry["url"],
            "isDraft": draft,
            "state": ("merged" if state == "MERGED"
                      else "draft" if draft else state.lower()),
            "review": node.get("reviewDecision") or None,
            "ci": _rollup_of(node),
            "threads": _unresolved(node),
        }
    return resolved, limited, answered


def group_by_host(entries: list[dict]) -> list[tuple[str, list[dict]]]:
    """One query per host: they are different GitHub installations."""
    by_host: dict[str, list[dict]] = {}
    for e in entries:
        by_host.setdefault(e["host"], []).append(e)
    return sorted(by_host.items())


def _is_fresh(row: dict, now: float) -> bool:
    """A merged or closed pull request has nothing left to change, and one
    GitHub would not show is worth asking about far less often than an open
    one."""
    state = row.get("pr", {}).get("state")
    ttl = (FRESH_TERMINAL if state in TERMINAL_STATES
           else FRESH_UNKNOWN if state == "unknown"
           else FRESH_OPEN)
    return now - row.get("at", 0) < ttl


def _unresolved_entry(entry: dict, bare: bool = False) -> dict:
    unknown = {"state": "unknown", "isDraft": False, "title": entry.get("title", ""),
               "url": entry["url"], "review": None, "ci": "none", "threads": None}
    return unknown if bare else {**entry, **unknown}


def resolve_all(entries: dict, cache_path: Path = CACHE_FILE,
                now: float | None = None) -> list[dict]:
    now = time.time() if now is None else now
    cache = cache_load(cache_path)
    rows = cache.get("prs") or {}
    wanted = list(entries.values())
    stale = [e for e in wanted
             if not _is_fresh(rows.get(cache_key(e), {}), now)]

    if stale and now >= (cache.get("pausedUntil") or 0):
        limited = False
        for host, group in group_by_host(stale):
            ok, out = run(["gh", "api", "graphql", "-f", "query=" + batch_query(group)],
                          env=gh_env(host))
            resolved, hit, answered = parse_batch(out, group)
            limited = limited or hit or (not ok and "rate limit" in out.lower())
            for key, pr in resolved.items():
                rows[key] = {"at": now, "pr": pr}
            if answered:
                for entry in group:
                    key = cache_key(entry)
                    if key not in resolved:
                        rows[key] = {"at": now, "pr": _unresolved_entry(entry, bare=True)}
        # Asking again inside the hour only spends what is no longer there;
        # the panel keeps showing the last answer meanwhile.
        cache["pausedUntil"] = now + RATE_LIMIT_PAUSE if limited else 0
        keys = {cache_key(e) for e in wanted}
        cache["prs"] = {k: r for k, r in rows.items()
                        if k in keys or now - r.get("at", 0) < CACHE_KEEP}
        cache_save(cache, cache_path)

    out = []
    for entry in wanted:
        row = rows.get(cache_key(entry))
        out.append({**entry, **row["pr"]} if row else _unresolved_entry(entry))
    return out


# ── git / plans ───────────────────────────────────────────────────────────

def default_repo_of(project: Path) -> str | None:
    ok, out = run(["git", "-C", str(project), "remote", "get-url", "origin"])
    if not ok:
        return None
    m = re.search(r"(?:" + _gh_host_pattern() + r")[:/]([\w.-]+/[\w.-]+?)(?:\.git)?$", out)
    return m.group(1) if m else None


def git_state(project: Path) -> dict:
    ok, branch = run(["git", "-C", str(project), "branch", "--show-current"])
    if not ok:
        return {"branch": None}
    _, dirty = run(["git", "-C", str(project), "status", "--porcelain"])
    ab_ok, ab = run(["git", "-C", str(project), "rev-list", "--left-right", "--count",
                     "@{upstream}...HEAD"])
    behind = ahead = None
    if ab_ok and ab:
        parts = ab.split()
        if len(parts) == 2:
            behind, ahead = int(parts[0]), int(parts[1])
    return {"branch": branch, "dirty": bool(dirty), "ahead": ahead, "behind": behind}


def parse_plan(path: Path) -> dict | None:
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return None
    items = [{"text": m.group(2).strip(), "checked": m.group(1).lower() == "x"}
             for m in re.finditer(r"^\s*[-*] \[([ xX])\]\s+(.+)$", text, re.M)]
    if not items:
        return None
    return {"path": str(path), "done": sum(i["checked"] for i in items),
            "total": len(items), "items": items,
            "mtime": path.stat().st_mtime}


def collect_plans(project: Path, touched_md: list[str]) -> list[dict]:
    candidates: dict[str, Path] = {}
    for sub in ("docs/superpowers/specs", "docs/superpowers/plans"):
        d = project / sub
        if d.is_dir():
            for f in d.glob("*.md"):
                candidates[str(f)] = f
    for fp in touched_md:
        p = Path(fp)
        if p.is_file():
            candidates[str(p)] = p
    plans = [p for p in (parse_plan(f) for f in candidates.values()) if p]
    plans.sort(key=lambda p: p["mtime"], reverse=True)
    for p in plans:
        del p["mtime"]
    return plans


# ── tmux / cwd ────────────────────────────────────────────────────────────

def cwd_for_session(session: str) -> str | None:
    ok, out = run(["tmux", "display", "-p", "-t", session, "#{pane_current_path}"])
    p = out.strip()
    return p if ok and p else None


# ── todos / plan ──────────────────────────────────────────────────────────

_TODO_STATE = {"completed": "done", "in_progress": "active", "pending": "pending"}


def _json_object(raw) -> dict:
    """A tool call's arguments as a dict. Codex stores them as a JSON string,
    Pi usually as an object; anything else counts as no arguments."""
    if isinstance(raw, str):
        try:
            raw = json.loads(raw)
        except json.JSONDecodeError:
            return {}
    return raw if isinstance(raw, dict) else {}


def latest_todos(events, harness: str = "claude") -> list[dict]:
    if harness == "codex":
        return codex_todos(events)
    if harness == "pi":
        return pi_todos(events)
    if harness == "opencode":
        return opencode_todos(events)
    if harness == "kimi":
        return kimi_todos(events)
    if harness in ("cline", "antigravity"):
        # Neither CLI has a todo tool: Cline 3.x dropped the focus chain the
        # VS Code extension keeps, and agy's `manage_task` runs commands.
        return []
    return latest_tasks(events) or todo_write_items(events)


_OPENCODE_TODO_STATE = {**_TODO_STATE, "cancelled": "done"}


def opencode_todos(events) -> list[dict]:
    """opencode keeps the current checklist in its `todo` table, replaced on
    every `todowrite` call. The last call's own input stands in only when the
    table could not be read."""
    latest = next((d["todos"] for d in events if isinstance(d.get("todos"), list)), None)
    if latest is None:
        for d in events:
            part = d.get("part")
            if not isinstance(part, dict) or part.get("tool") != "todowrite":
                continue
            state = part.get("state") if isinstance(part.get("state"), dict) else {}
            items = _json_object(state.get("input")).get("todos")
            if isinstance(items, list):
                latest = items
    return [{"text": _text(t.get("content")),
             "state": _OPENCODE_TODO_STATE.get(_text(t.get("status")), "pending")}
            for t in latest or [] if isinstance(t, dict)]


_KIMI_TODO_STATE = {"done": "done", "in_progress": "active", "pending": "pending"}


def kimi_todos(events) -> list[dict]:
    """Kimi persists its `TodoList` as a `tools.update_store` record under the
    key `todo`; the last one is the current list, and `[]` clears it."""
    latest = None
    for d in events:
        if d.get("type") == "tools.update_store" and d.get("key") == "todo":
            if isinstance(d.get("value"), list):
                latest = d["value"]
    return [{"text": _text(t.get("title")),
             "state": _KIMI_TODO_STATE.get(_text(t.get("status")), "pending")}
            for t in latest or [] if isinstance(t, dict)]


def codex_todos(events) -> list[dict]:
    """The last `update_plan` call's checklist, Codex's equivalent of
    TodoWrite. Not every Codex build offers that tool, so a session with no
    plan is the common case, not a bug — `latest_todos` returns `[]` for it.
    """
    latest = None
    for d in events:
        if d.get("type") != "response_item":
            continue
        payload = d.get("payload")
        if not isinstance(payload, dict) or payload.get("type") != "function_call":
            continue
        if payload.get("name") != "update_plan":
            continue
        plan = _json_object(payload.get("arguments")).get("plan")
        if isinstance(plan, list):
            latest = plan
    if not latest:
        return []
    return [{"text": t.get("step", ""), "state": _TODO_STATE.get(t.get("status", ""), "pending")}
            for t in latest if isinstance(t, dict)]


def pi_todos(events) -> list[dict]:
    """No local Pi session used a dedicated todo tool, so this reads the last
    `toolCall` whose name and `todos` argument look like Claude's TodoWrite —
    a session that tracks a checklist is expected to name it plainly.
    """
    latest = None
    for d in events:
        if d.get("type") != "message":
            continue
        msg = d.get("message")
        if not isinstance(msg, dict):
            continue
        for c in msg.get("content") or []:
            if not isinstance(c, dict) or c.get("type") != "toolCall":
                continue
            if c.get("name") not in ("todo_write", "update_todos", "todos"):
                continue
            items = _json_object(c.get("arguments")).get("todos")
            if isinstance(items, list):
                latest = items
    if not latest:
        return []
    return [{"text": t.get("content", t.get("text", "")),
             "state": _TODO_STATE.get(t.get("status", ""), "pending")}
            for t in latest if isinstance(t, dict)]


def latest_tasks(events) -> list[dict]:
    """TaskCreate/TaskUpdate checklist (Claude Code 2.1.2xx), in creation order.

    State comes from `toolUseResult`, never from the tool call: the model
    sometimes calls TaskCreate with a batch `tasks` argument, which the tool
    rejects — the call is in the transcript, the task never existed.
    """
    tasks: dict[str, dict] = {}
    for d in events:
        res = d.get("toolUseResult")
        if not isinstance(res, dict):
            continue
        created = res.get("task")
        if isinstance(created, dict) and created.get("id") is not None:
            tasks[str(created["id"])] = {"text": created.get("subject", ""),
                                         "state": "pending"}
            continue
        if not res.get("success"):
            continue
        task = tasks.get(str(res.get("taskId")))
        to = (res.get("statusChange") or {}).get("to")
        if task and to:
            task["state"] = _TODO_STATE.get(to, task["state"])
    return list(tasks.values())


def todo_write_items(events) -> list[dict]:
    latest = None
    for d in events:
        msg = d.get("message")
        if not isinstance(msg, dict):
            continue
        content = msg.get("content")
        if not isinstance(content, list):
            continue
        for b in content:
            if isinstance(b, dict) and b.get("type") == "tool_use" and b.get("name") == "TodoWrite":
                todos = b.get("input", {}).get("todos")
                if isinstance(todos, list):
                    latest = todos
    if not latest:
        return []
    return [{"text": t.get("content", ""),
             "state": _TODO_STATE.get(t.get("status", ""), "pending")}
            for t in latest if isinstance(t, dict)]


def build_plan(todos: list[dict]) -> dict | None:
    if not todos:
        return None
    done = sum(1 for t in todos if t["state"] == "done")
    return {"title": "todos", "source": "todos",
            "done": done, "total": len(todos), "items": todos}


# ── background work (monitors, shells, subagents) ─────────────────────────

def _task_label(inp: dict, keys: tuple, limit: int = 56) -> str:
    for k in keys:
        v = (inp.get(k) or "")
        if isinstance(v, str) and v.strip():
            text = v.strip().splitlines()[0]
            return text if len(text) <= limit else text[:limit - 1] + "…"
    return ""


def extract_background(events, harness: str = "claude") -> dict:
    if harness == "codex":
        return _extract_background_codex(events)
    if harness == "pi":
        # No local Pi session showed a background-work marker: its `subagent`
        # tool returned in the same turn it was called, with no async id to
        # track. Nothing to report is the honest answer, not a guess.
        return {"monitors": [], "shells": [], "agents": []}
    if harness == "opencode":
        return _extract_background_opencode(events)
    if harness == "kimi":
        return _extract_background_kimi(events)
    if harness == "cline":
        return _extract_background_cline(events)
    if harness == "antigravity":
        # A subagent is a conversation of its own under `brain/`, and nothing
        # in either transcript says reliably that it is still working.
        return {"monitors": [], "shells": [], "agents": []}
    return _extract_background_claude(events)


def _running_agents(spawned: dict, finished: set, started: dict, newest: str) -> dict:
    agents = [{"label": label, "status": "running"} for key, label in spawned.items()
              if key not in finished and not _is_stale(started.get(key), newest)]
    return {"monitors": [], "shells": [], "agents": agents}


def _extract_background_opencode(events) -> dict:
    """A `task` part stays `pending` or `running` while its subagent works in a
    child session, and turns `completed` or `error` when it returns."""
    spawned, started, newest = {}, {}, ""
    for i, d in enumerate(events):
        newest = max(newest, _text(d.get("updated")) or _text(d.get("ts")))
        part = d.get("part")
        if not isinstance(part, dict) or part.get("tool") != "task":
            continue
        state = part.get("state") if isinstance(part.get("state"), dict) else {}
        if state.get("status") in ("pending", "running"):
            label = _task_label(_json_object(state.get("input")),
                                ("description", "subagent_type", "prompt"))
            spawned[i] = label or _text(part.get("callID")) or "task"
            started[i] = _text(d.get("ts"))
    return _running_agents(spawned, set(), started, newest)


def _extract_background_kimi(events) -> dict:
    """The parent wire records `subagent.spawned`, then one terminal record:
    `completed`, `failed` or `cancelled`."""
    spawned, started, finished, newest = {}, {}, set(), ""
    for d in events:
        ts = _iso_ms(d.get("time"))
        newest = max(newest, ts)
        agent = d.get("subagentId")
        if not isinstance(agent, str):
            continue
        kind = d.get("type")
        if kind == "subagent.spawned":
            spawned[agent] = _task_label(d, ("description", "subagentName")) or agent
            started[agent] = ts
        elif kind in ("subagent.completed", "subagent.failed", "subagent.cancelled"):
            finished.add(agent)
    return _running_agents(spawned, finished, started, newest)


def _extract_background_cline(events) -> dict:
    """`spawn_agent` holds the turn until its subagent answers, so a call
    without its `tool_result` yet is a subagent still at work."""
    spawned, started, finished, newest = {}, {}, set(), ""
    for msg in events:
        ts = _iso_ms(msg.get("ts"))
        newest = max(newest, ts)
        content = msg.get("content")
        for b in content if isinstance(content, list) else []:
            if not isinstance(b, dict):
                continue
            if (b.get("type") == "tool_use" and b.get("name") == "spawn_agent"
                    and isinstance(b.get("id"), str)):
                label = _task_label(_json_object(b.get("input")), ("task", "systemPrompt"))
                spawned[b["id"]] = label or b["id"]
                started[b["id"]] = ts
            elif b.get("type") == "tool_result" and isinstance(b.get("tool_use_id"), str):
                finished.add(b["tool_use_id"])
    return _running_agents(spawned, finished, started, newest)


def _extract_background_codex(events) -> dict:
    """Subagents from Codex's multi-agent tools. Codex has no background shell
    or monitor: `exec` holds the turn until the command returns.

    `spawn_agent` answers at once with the agent's path (`/root/<task_name>`),
    so its output says nothing about the agent being done. The agent is done
    when it sends its `FINAL_ANSWER` message, when it is interrupted, or when
    `list_agents` stops calling it `running`.
    """
    calls, spawned, started, finished = {}, {}, {}, set()
    newest = ""
    for d in events:
        stamp = d.get("timestamp")
        if isinstance(stamp, str) and stamp > newest:
            newest = stamp
        if d.get("type") != "response_item":
            continue
        payload = d.get("payload")
        if not isinstance(payload, dict):
            continue
        kind = payload.get("type")
        if kind == "function_call":
            name, call_id = payload.get("name"), payload.get("call_id")
            args = _json_object(payload.get("arguments"))
            if call_id:
                calls[call_id] = name
            if name == "spawn_agent" and call_id:
                task = args.get("task_name")
                key = f"/root/{task}" if isinstance(task, str) and task else call_id
                spawned[call_id] = [key, task or call_id]
                started[call_id] = stamp
            elif name == "interrupt_agent" and isinstance(args.get("target"), str):
                finished.add(args["target"])
        elif kind == "function_call_output":
            call_id = payload.get("call_id")
            out = _json_object(payload.get("output"))
            if calls.get(call_id) == "spawn_agent" and isinstance(out.get("task_name"), str):
                spawned[call_id][0] = out["task_name"]
            elif calls.get(call_id) == "list_agents":
                for agent in out.get("agents") or []:
                    if isinstance(agent, dict) and agent.get("agent_status") != "running":
                        finished.add(str(agent.get("agent_name")))
        elif kind == "agent_message":
            text = " ".join(c.get("text", "") for c in payload.get("content") or []
                            if isinstance(c, dict) and isinstance(c.get("text"), str))
            if CODEX_DONE_MARK in text and isinstance(payload.get("author"), str):
                finished.add(payload["author"])

    def done(path: str) -> bool:
        return path in finished or path.rsplit("/", 1)[-1] in finished

    agents = [{"label": label, "status": "running"}
              for call_id, (path, label) in spawned.items()
              if not done(path) and not _is_stale(started.get(call_id), newest)]
    return {"monitors": [], "shells": [], "agents": agents}


def _extract_background_claude(events) -> dict:
    """Work that runs outside the turn: monitors, background shells, subagents.

    Each one ends with the `<task-notification>` for its id, never with the
    tool_result — the tool returns as soon as the work is launched.
    """
    tool_inputs, result_ids, finished = {}, set(), set()
    monitors, shells, subagents, dispatches = {}, {}, {}, {}
    started, newest = {}, ""
    for d in events:
        stamp = d.get("timestamp")
        if isinstance(stamp, str) and stamp > newest:
            newest = stamp
        text = d.get("content")
        if isinstance(text, str):
            finished.update(TASK_DONE_RE.findall(text))
        # A task notification is not a message: it arrives as an attachment
        # record whose prompt carries the `<task-id>`. Reading only messages
        # left every background task marked as running for ever.
        attachment = d.get("attachment")
        if isinstance(attachment, dict):
            # Claude has emitted queued task notifications under both keys:
            # older transcripts use `prompt`, current ones use `text`.
            for field in ("prompt", "text"):
                notification = attachment.get(field)
                if isinstance(notification, str):
                    finished.update(TASK_DONE_RE.findall(notification))
        result = d.get("toolUseResult")
        if isinstance(result, dict):
            # Current Claude transcripts record a collected background task as
            # a TaskOutput result instead of emitting an XML notification.
            task_id = result.get("task_id")
            if isinstance(task_id, str):
                finished.add(task_id)
        msg = d.get("message")
        if not isinstance(msg, dict):
            continue
        content = msg.get("content")
        if isinstance(content, str):
            finished.update(TASK_DONE_RE.findall(content))
        for b in content if isinstance(content, list) else []:
            if not isinstance(b, dict):
                continue
            kind = b.get("type")
            if kind == "text":
                finished.update(TASK_DONE_RE.findall(b.get("text", "")))
            elif kind == "tool_use" and b.get("id"):
                tool_inputs[b["id"]] = b.get("input", {}) or {}
                if b.get("name") in ("Task", "Agent"):
                    dispatches[b["id"]] = tool_inputs[b["id"]]
            elif kind == "tool_result":
                tuid = b.get("tool_use_id")
                if tuid:
                    result_ids.add(tuid)
                res = d.get("toolUseResult")
                if not isinstance(res, dict):
                    continue
                inp = tool_inputs.get(tuid, {})
                if res.get("backgroundTaskId"):
                    shells[res["backgroundTaskId"]] = _task_label(inp, ("description", "command"))
                    started[res["backgroundTaskId"]] = d.get("timestamp")
                elif res.get("taskId") and "timeoutMs" in res:
                    monitors[res["taskId"]] = _task_label(inp, ("description", "command"))
                    started[res["taskId"]] = d.get("timestamp")
                elif res.get("isAsync") and res.get("agentId"):
                    subagents[res["agentId"]] = (res.get("description")
                                                 or _task_label(inp, ("description", "subagent_type", "prompt")))
                    started[res["agentId"]] = d.get("timestamp")
    def still_running(group):
        return [{"label": label or key, "status": "running"}
                for key, label in group.items()
                if key not in finished and not _is_stale(started.get(key), newest)]

    agents = still_running(subagents)
    for tid, inp in dispatches.items():
        if tid not in result_ids:
            agents.append({"label": _task_label(inp, ("description", "subagent_type", "prompt")) or tid,
                           "status": "running"})
    return {"monitors": still_running(monitors),
            "shells": still_running(shells),
            "agents": agents}


# A notification can go missing — the session ends, the app restarts, the
# harness drops it. Without a cutoff that task spins in the panel for ever.
STALE_AFTER = timedelta(hours=6)


def _is_stale(started: str | None, newest: str) -> bool:
    """True when the task began long before the last thing in the transcript."""
    if not started or not newest:
        return False
    try:
        began = datetime.fromisoformat(started.replace("Z", "+00:00"))
        last = datetime.fromisoformat(newest.replace("Z", "+00:00"))
    except ValueError:
        return False
    return last - began > STALE_AFTER


def merge_refs(dst: dict, src: dict) -> None:
    """Fold another transcript's references into the first one's."""
    for kind in ("github", "links"):
        for key, entry in src[kind].items():
            kept = dst[kind].setdefault(key, entry)
            if kept is not entry:
                kept["count"] = kept.get("count", 0) + entry.get("count", 0)
                seen_at(kept, entry.get("last_ts", ""))


# ── prs / links ───────────────────────────────────────────────────────────

_REVIEW = {"APPROVED": "approved", "CHANGES_REQUESTED": "changes",
           "REVIEW_REQUIRED": "required", "": "none", None: "none"}


def map_prs(github: list[dict]) -> list[dict]:
    out = []
    for g in github:
        state = "draft" if g.get("isDraft") else g.get("state", "open").lower()
        pr = {"number": g["num"], "repo": g["repo"], "title": g.get("title", ""),
              "url": g["url"], "ci": g.get("ci", "none"),
              "review": _REVIEW.get(g.get("review"), "none"), "state": state}
        if g.get("threads"):
            pr["threads"] = g["threads"]
        if g.get("last_ts"):
            pr["lastSeen"] = g["last_ts"]
        out.append(pr)
    return out


def _label(url: str) -> str:
    s = re.sub(r"^https?://", "", url).rstrip("/")
    return s if len(s) <= 48 else s[:47] + "…"


def service_of(url: str) -> str:
    """The service a URL belongs to, from its domain: linear, atlassian, github.

    No tracker is special-cased — a new one names itself.
    """
    host = re.sub(r"^https?://", "", url).split("/")[0].split(":")[0]
    parts = [p for p in host.split(".") if p != "www"]
    name = parts[-2] if len(parts) >= 2 else (parts[0] if parts else "web")
    # gist.githubusercontent.com and friends are the same service as the site.
    return name[: -len("usercontent")] if name.endswith("usercontent") else name


def map_links(links: list[dict]) -> list[dict]:
    """One row per link. The same issue reached by two URLs is one row."""
    out, seen_keys = [], set()
    for l in links:
        key = ISSUE_KEY_RE.search(l["url"])
        if key:
            if key.group(1) in seen_keys:
                continue
            seen_keys.add(key.group(1))
        out.append({"url": l["url"],
                    "label": key.group(1) if key else _label(l["url"]),
                    "kind": service_of(l["url"])})
    return out


# ── main ──────────────────────────────────────────────────────────────────

def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


# Program names, matched whole: `kimi-code` is the title Kimi gives its
# process, `.cline` the native binary Cline's node launcher starts, `agy`
# Antigravity's CLI.
PROGRAM_HARNESSES = {"opencode": "opencode", "kimi": "kimi", "kimi-code": "kimi",
                     "cline": "cline", ".cline": "cline", "agy": "antigravity"}
SCRIPT_RUNTIMES = ("node", "bun", "deno")
# What tmux shows as the pane command, for a harness not named after its id.
PANE_COMMANDS = {"kimi-code": "kimi", "agy": "antigravity", ".cline": "cline"}


def _program_names(words: list[str]):
    """The program a command line runs: its first word, and the script after
    a runtime (`node /home/alice/.local/bin/cline`), flags skipped."""
    first = words[0].rsplit("/", 1)[-1]
    yield first
    if first in SCRIPT_RUNTIMES:
        script = next((w for w in words[1:] if not w.startswith("-")), None)
        if script:
            yield script.rsplit("/", 1)[-1]


def _harness_in(args: str) -> str | None:
    """The harness a process command line runs, from its install path or name."""
    words = args.split()
    if not words:
        return None
    first = words[0].rsplit("/", 1)[-1]
    if first == "claude" or "/claude/versions/" in args:
        return "claude"
    if first == "codex" or "@openai/codex" in args:
        return "codex"
    if first == "pi" or "pi-coding-agent" in args:
        return "pi"
    for name in _program_names(words):
        if name in PROGRAM_HARNESSES:
            return PROGRAM_HARNESSES[name]
    return None


def pane_harness(session: str) -> str | None:
    """The harness running in the session's tmux pane, or None.

    tmux names the pane's foreground command, which is rarely the harness:
    Codex, Pi (from npm) and Cline are node scripts, so the pane says `node`,
    Claude's binary is named after its version, and Kimi and Antigravity go
    by `kimi-code` and `agy`. When the name is not enough, the command lines
    of the processes under the pane settle it.
    """
    ok, out = run(["tmux", "display", "-p", "-t", session,
                   "#{pane_current_command}\t#{pane_pid}"])
    if not ok:
        return None
    cmd, _, pid = out.strip().partition("\t")
    cmd = cmd.strip().lower()
    cmd = PANE_COMMANDS.get(cmd, cmd)
    if cmd in HARNESSES:
        return cmd
    if VERSION_RE.fullmatch(cmd):
        return "claude"
    ok, table = run(["ps", "-A", "-o", "pid=,ppid=,args="])
    if not ok or not pid.strip().isdigit():
        return None
    root = pid.strip()
    children: dict[str, list[tuple[str, str]]] = {}
    for line in table.splitlines():
        parts = line.split(None, 2)
        if len(parts) != 3:
            continue
        if parts[0] == root and _harness_in(parts[2]):
            return _harness_in(parts[2])
        children.setdefault(parts[1], []).append((parts[0], parts[2]))
    queue = [root]
    while queue:
        for child, args in children.get(queue.pop(0), []):
            found = _harness_in(args)
            if found:
                return found
            queue.append(child)
    return None


def detect_harness(session: str | None, project: Path) -> str:
    """Which coding-agent harness owns this session: claude, codex, pi,
    opencode, kimi, cline or antigravity.

    The tmux pane's running command is the strongest signal when a session
    name is given — a pane runs one harness at a time, and still shows it
    after the harness itself goes idle waiting on the user. That check is
    skipped, or inconclusive (no tmux session; a `zmx` session whose pane
    runs a shell instead of the harness directly), for a session started
    outside tmux. The fallback then is the project's most recently modified
    transcript across every harness: whichever one someone is actively
    driving is the one that wrote most recently.
    """
    running = pane_harness(session) if session else None
    if running:
        return running
    candidates = {
        "claude": find_transcript("auto", project),
        "codex": find_codex_transcript(project),
        "pi": find_pi_transcript(project),
        "opencode": find_opencode_transcript(project),
        "kimi": find_kimi_transcript(project),
        "cline": find_cline_transcript(project),
        "antigravity": find_antigravity_transcript(project),
    }
    best, best_mtime = "claude", -1.0
    for harness, tx in candidates.items():
        if tx is None:
            continue
        mtime = tx.updated if isinstance(tx, OpencodeSession) else _mtime(tx)
        if mtime is not None and mtime > best_mtime:
            best, best_mtime = harness, mtime
    return best


def _discover(harness: str, project: Path):
    recent = {"codex": recent_codex_transcripts, "pi": recent_pi_transcripts,
              "opencode": recent_opencode_transcripts, "kimi": recent_kimi_transcripts,
              "cline": recent_cline_transcripts,
              "antigravity": recent_antigravity_transcripts}.get(harness)
    if recent is None:
        return find_transcript("auto", project), recent_transcripts(project)
    found = recent(project)
    return (found[0] if found else None), found


def build_context(session: str | None, project: str | None, resolve: bool) -> dict:
    # No session name means the caller already knows the folder (the Mac, where
    # sessions live in zmx, which tmux cannot answer for).
    cwd = (cwd_for_session(session) if session else None) or project or "."
    proj = Path(cwd)
    harness = detect_harness(session, proj)
    tx, siblings = _discover(harness, proj)
    if tx is None:
        return {"cwd": str(proj), "isClaude": False, "harness": harness, "updatedAt": _now(),
                "plan": None, "prs": [], "links": [],
                "agents": [], "monitors": [], "shells": []}
    events = load_events(harness, tx)
    repo = default_repo_of(proj)
    refs = extract_refs(events, repo, harness)
    for other_tx in siblings:
        if other_tx != tx:
            merge_refs(refs, extract_refs(load_events(harness, other_tx), repo, harness))
    todos = latest_todos(events, harness)
    github = resolve_all(refs["github"]) if resolve else list(refs["github"].values())
    links = [{"url": u, **v} for u, v in refs["links"].items()]
    return {"cwd": str(proj), "isClaude": harness == "claude", "harness": harness,
            "updatedAt": _now(),
            "plan": build_plan(todos),
            "prs": map_prs(github),
            "links": map_links(links),
            **extract_background(events, harness)}


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--session", default=None, help="tmux session name; omit to use --project")
    ap.add_argument("--project", default=None, help="fallback project dir if tmux lookup fails")
    ap.add_argument("--no-resolve", action="store_true", help="skip gh lookups")
    args = ap.parse_args()

    if not args.session and not args.project:
        ap.error("give --session, --project, or both")
    ctx = build_context(args.session, args.project, resolve=not args.no_resolve)
    print(json.dumps(ctx, ensure_ascii=False))


if __name__ == "__main__":
    main()
