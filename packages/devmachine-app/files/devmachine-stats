#!/usr/bin/env python3
"""devmachine-stats: one machine's health, as one JSON document.

Usage:
    devmachine-stats

Reads memory, swap, disk, load, Docker containers, RAM by user, and
listening ports with their owner — the same facts the Devmachine macOS app
used to read by shipping a shell snippet over SSH. This script runs the
snippet's own commands (`free`, `df`, `/proc/loadavg`, `docker`, `ps`, `ss`)
on the machine itself and returns one structured document, so the app parses
JSON instead of a shell transcript. On macOS it reads the same facts from
`sysctl`, `vm_stat`, `df` and `lsof`, into the same document.

Deterministic and LLM-free. A missing tool (Docker not installed, no
listeners) is not a failure: the matching field comes back empty and a note
goes on "errors". The command only fails (non-zero exit, one JSON error
document) when it cannot report anything at all.
"""
from __future__ import annotations

import glob
import json
import os
import platform
import subprocess
import sys
from datetime import datetime, timezone

# Hostinger's own home-folder convention, and Devmachine's: a workspace's
# processes and containers live under here, so the folder names the owner.
# macOS keeps homes under /Users.
HOME_PREFIXES = ("/home/", "/Users/")


def run(cmd: list, timeout: int = 10):
    """Run a command, return (ok, stdout, error). Never raises."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        if p.returncode != 0:
            return False, "", (p.stderr.strip() or "%s: exit %d" % (cmd[0], p.returncode))
        return True, p.stdout, None
    except FileNotFoundError:
        return False, "", None
    except subprocess.TimeoutExpired:
        return False, "", "%s: timed out" % cmd[0]
    except OSError as e:
        return False, "", "%s: %s" % (cmd[0], e)


def owner_from_home(path: str) -> str | None:
    for prefix in HOME_PREFIXES:
        if path.startswith(prefix):
            name = path[len(prefix):].split("/", 1)[0]
            return name or None
    return None


# ── memory, swap ─────────────────────────────────────────────────────────

def read_memory_and_swap(errors: list):
    ok, out, err = run(["free", "-b"])
    memory = {"total_bytes": 0, "used_bytes": 0, "available_bytes": 0}
    swap = {"total_bytes": 0, "used_bytes": 0}
    if err:
        errors.append("free: %s" % err)
        return memory, swap
    if not ok:
        errors.append("free: not found")
        return memory, swap

    for line in out.splitlines():
        fields = line.split()
        if not fields:
            continue
        if fields[0] == "Mem:" and len(fields) >= 7:
            memory = {
                "total_bytes": int(fields[1]),
                "used_bytes": int(fields[2]),
                "available_bytes": int(fields[6]),
            }
        elif fields[0] == "Swap:" and len(fields) >= 3:
            swap = {"total_bytes": int(fields[1]), "used_bytes": int(fields[2])}
    return memory, swap


def read_memory_and_swap_darwin(errors: list):
    memory = {"total_bytes": 0, "used_bytes": 0, "available_bytes": 0}
    swap = {"total_bytes": 0, "used_bytes": 0}

    ok, out, err = run(["sysctl", "-n", "hw.memsize"])
    if err:
        errors.append("sysctl: %s" % err)
        return memory, swap
    if not ok:
        errors.append("sysctl: not found")
        return memory, swap
    try:
        total = int(out.strip())
    except ValueError:
        errors.append("sysctl hw.memsize: unexpected output")
        return memory, swap

    ok, out, err = run(["vm_stat"])
    if err:
        errors.append("vm_stat: %s" % err)
        return memory, swap
    if not ok:
        errors.append("vm_stat: not found")
        return memory, swap
    page_size, pages = parse_vm_stat(out)

    # Activity Monitor's "Memory Used": app memory, wired and compressed.
    if "Anonymous pages" in pages:
        app = pages["Anonymous pages"] - pages.get("Pages purgeable", 0)
    else:
        app = pages.get("Pages active", 0)
    used = (app + pages.get("Pages wired down", 0) + pages.get("Pages occupied by compressor", 0)) * page_size
    used = min(used, total)
    memory = {"total_bytes": total, "used_bytes": used, "available_bytes": total - used}

    ok, out, err = run(["sysctl", "-n", "vm.swapusage"])
    if err:
        errors.append("sysctl: %s" % err)
    elif ok:
        values = parse_swapusage(out)
        swap = {"total_bytes": values.get("total", 0), "used_bytes": values.get("used", 0)}
    return memory, swap


def parse_vm_stat(text: str):
    """`vm_stat` -> (page size, {"Pages free": 6624, ...})."""
    page_size = 4096
    pages = {}
    for line in text.splitlines():
        if "page size of" in line:
            try:
                page_size = int(line.split("page size of", 1)[1].split()[0])
            except (IndexError, ValueError):
                pass
            continue
        name, sep, value = line.partition(":")
        if not sep:
            continue
        try:
            pages[name.strip().strip('"')] = int(value.strip().rstrip("."))
        except ValueError:
            continue
    return page_size, pages


SWAP_UNITS = {"K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}


def parse_swapusage(text: str):
    """`total = 2048.00M  used = 1024.50M  free = ...` -> {"total": bytes, ...}."""
    values = {}
    tokens = text.split()
    for i in range(len(tokens) - 2):
        if tokens[i + 1] != "=":
            continue
        amount = tokens[i + 2]
        multiplier = SWAP_UNITS.get(amount[-1:], 1)
        try:
            values[tokens[i]] = int(float(amount.rstrip("KMGT")) * multiplier)
        except ValueError:
            continue
    return values


# ── disk ─────────────────────────────────────────────────────────────────

def read_disk(errors: list):
    disk = {"path": "/", "used_bytes": 0, "available_bytes": 0, "used_percent": 0}
    ok, out, err = run(["df", "-B1", "--output=used,avail,pcent", "/"])
    if err:
        errors.append("df: %s" % err)
        return disk
    if not ok:
        errors.append("df: not found")
        return disk

    lines = [l for l in out.splitlines() if l.strip()]
    if len(lines) < 2:
        errors.append("df: unexpected output")
        return disk
    fields = lines[-1].split()
    if len(fields) < 3:
        errors.append("df: unexpected output")
        return disk
    disk["used_bytes"] = int(fields[0])
    disk["available_bytes"] = int(fields[1])
    disk["used_percent"] = int(fields[2].rstrip("%"))
    return disk


# The system volume at / is read-only and sealed; what fills up is the data
# volume beside it, which holds the homes and every installed tool.
MACOS_DATA_VOLUME = "/System/Volumes/Data"


def read_disk_darwin(errors: list):
    path = MACOS_DATA_VOLUME if os.path.isdir(MACOS_DATA_VOLUME) else "/"
    disk = {"path": path, "used_bytes": 0, "available_bytes": 0, "used_percent": 0}
    ok, out, err = run(["df", "-k", path])
    if err:
        errors.append("df: %s" % err)
        return disk
    if not ok:
        errors.append("df: not found")
        return disk

    lines = [l for l in out.splitlines() if l.strip()]
    fields = lines[-1].split() if len(lines) >= 2 else []
    if len(fields) < 5:
        errors.append("df: unexpected output")
        return disk
    try:
        disk["used_bytes"] = int(fields[2]) * 1024
        disk["available_bytes"] = int(fields[3]) * 1024
        disk["used_percent"] = int(fields[4].rstrip("%"))
    except ValueError:
        errors.append("df: unexpected output")
    return disk


# ── load ─────────────────────────────────────────────────────────────────

def read_load(errors: list):
    load = {"load1": 0.0, "load5": 0.0, "load15": 0.0}
    try:
        fields = open("/proc/loadavg", encoding="utf-8").read().split()
    except OSError as e:
        errors.append("/proc/loadavg: %s" % e)
        return load
    if len(fields) < 3:
        errors.append("/proc/loadavg: unexpected content")
        return load
    load = {"load1": float(fields[0]), "load5": float(fields[1]), "load15": float(fields[2])}
    return load


def read_load_darwin(errors: list):
    load = {"load1": 0.0, "load5": 0.0, "load15": 0.0}
    ok, out, err = run(["sysctl", "-n", "vm.loadavg"])
    if err:
        errors.append("sysctl: %s" % err)
        return load
    if not ok:
        errors.append("sysctl: not found")
        return load
    fields = out.replace("{", " ").replace("}", " ").split()
    try:
        return {"load1": float(fields[0]), "load5": float(fields[1]), "load15": float(fields[2])}
    except (IndexError, ValueError):
        errors.append("sysctl vm.loadavg: unexpected output")
        return load


# ── docker ───────────────────────────────────────────────────────────────

# Longest suffix first: "MiB" ends with "B" too, and checking "B" first would
# strip only the "B" off "MiB" and leave "Mi" for float() to reject.
UNIT_MULTIPLIER = [("KiB", 1024), ("MiB", 1024**2), ("GiB", 1024**3), ("TiB", 1024**4), ("B", 1)]


def parse_size(text: str) -> int:
    """"12.34MiB" -> bytes. An amount `docker stats` cannot parse gives 0
    rather than raising: a partial reading beats a failed command."""
    text = text.strip()
    for unit, multiplier in UNIT_MULTIPLIER:
        if text.endswith(unit):
            try:
                return int(float(text[: -len(unit)]) * multiplier)
            except ValueError:
                return 0
    return 0


# A Mac runs one colima VM per workspace account, each with its own socket,
# and root's PATH has no Homebrew.
COLIMA_SOCKETS = "/Users/*/.colima/default/docker.sock"
DARWIN_DOCKER_BINARIES = ("/opt/homebrew/bin/docker", "/usr/local/bin/docker")
DEFAULT_DOCKER = ["docker"]


def docker_endpoints(system: str) -> list:
    """(docker command, account) for each daemon to ask. Linux has one
    daemon; a container on it has no account until a label names one."""
    if system != "Darwin":
        return [(DEFAULT_DOCKER, None)]
    binary = next((b for b in DARWIN_DOCKER_BINARIES if os.path.exists(b)), "docker")
    sockets = sorted(glob.glob(COLIMA_SOCKETS))
    if not sockets:
        return [([binary], None)]
    return [([binary, "--host", "unix://" + s], owner_from_home(s)) for s in sockets]


def docker_error(errors: list, what: str, err: str, account):
    """A colima socket left behind by a stopped VM refuses the connection:
    that account's Docker is not running, which is not an error."""
    if account and err.startswith("Cannot connect to the Docker daemon"):
        return
    errors.append("%s: %s" % (what, err))


def container_owners(errors: list, docker: list = DEFAULT_DOCKER, account=None) -> dict:
    """Name -> owning user, from the folder Compose or the Supabase CLI
    started the container from, else the account whose colima runs it. A
    container with neither has no owner, and is shown to everyone rather
    than guessed at."""
    fmt = '{{.Names}}|{{.Label "com.docker.compose.project.working_dir"}}{{.Label "com.supabase.cli.workdir"}}'
    ok, out, err = run(docker + ["ps", "--format", fmt])
    if err:
        docker_error(errors, "docker ps", err, account)
        return {}
    if not ok:
        return {}
    owners = {}
    for line in out.splitlines():
        parts = line.split("|", 1)
        if len(parts) != 2:
            continue
        name, workdir = parts[0].strip(), parts[1].strip()
        owner = owner_from_home(workdir) or account
        if name and owner:
            owners[name] = owner
    return owners


def read_docker(errors: list, endpoints: list | None = None):
    docker = {"available": False, "containers": []}
    for command, account in endpoints or docker_endpoints("Linux"):
        read_one_docker(errors, docker, command, account)
    return docker


def read_one_docker(errors: list, docker: dict, command: list, account):
    ok, out, err = run(command + ["stats", "--no-stream", "--format", "{{.Name}}|{{.MemUsage}}|{{.CPUPerc}}"])
    if err:
        docker_error(errors, "docker stats", err, account)
        return
    if not ok:
        return

    docker["available"] = True
    owners = container_owners(errors, command, account)
    for line in out.splitlines():
        parts = line.split("|")
        if len(parts) != 3:
            continue
        name = parts[0].strip()
        mem_used, _, mem_limit = parts[1].partition("/")
        docker["containers"].append({
            "name": name,
            "mem_used_bytes": parse_size(mem_used),
            "mem_limit_bytes": parse_size(mem_limit),
            "cpu_percent": float(parts[2].strip().rstrip("%") or 0),
            "owner": owners.get(name),
        })


# ── ram by user ──────────────────────────────────────────────────────────

def read_users(errors: list):
    ok, out, err = run(["ps", "-eo", "user=,rss="])
    if err:
        errors.append("ps: %s" % err)
        return []
    if not ok:
        errors.append("ps: not found")
        return []

    totals: dict = {}
    for line in out.splitlines():
        fields = line.split()
        if len(fields) < 2:
            continue
        user, rss_kb = fields[0], fields[1]
        try:
            totals[user] = totals.get(user, 0) + int(rss_kb) * 1024
        except ValueError:
            continue
    users = [{"user": user, "rss_bytes": rss} for user, rss in totals.items()]
    users.sort(key=lambda u: u["rss_bytes"], reverse=True)
    return users


# ── ports ────────────────────────────────────────────────────────────────

def published_ports(column: str):
    """The host ports of a `{{.Ports}}` column: `0.0.0.0:8810->80/tcp,
    [::]:8810->80/tcp` and a range, `9000-9001->9000-9001/tcp`, one mapping
    for both ends."""
    ports = set()
    for mapping in column.split(","):
        if "->" not in mapping:
            continue
        left = mapping.split("->", 1)[0]
        if ":" not in left:
            continue
        value = left.rsplit(":", 1)[1].strip()
        bounds = value.split("-")
        try:
            bounds = [int(b) for b in bounds]
        except ValueError:
            continue
        if len(bounds) == 1:
            ports.add(bounds[0])
        elif len(bounds) == 2 and bounds[0] <= bounds[1]:
            ports.update(range(bounds[0], bounds[1] + 1))
    return ports


def listening_port(line: str):
    columns = line.split()
    if len(columns) < 4 or ":" not in columns[3]:
        return None
    try:
        return int(columns[3].rsplit(":", 1)[1])
    except ValueError:
        return None


def first_pid(line: str):
    marker = "pid="
    idx = line.find(marker)
    if idx == -1:
        return None
    digits = ""
    for ch in line[idx + len(marker):]:
        if not ch.isdigit():
            break
        digits += ch
    return int(digits) if digits else None


def container_published_ports(errors: list, endpoints: list | None = None):
    container_ports = []
    for command, account in endpoints or docker_endpoints("Linux"):
        ok, out, err = run(command + ["ps", "--format", '{{.Names}}|{{.Label "com.docker.compose.project.working_dir"}}{{.Label "com.supabase.cli.workdir"}}|{{.Ports}}'])
        if ok:
            for line in out.splitlines():
                parts = line.split("|", 2)
                if len(parts) != 3:
                    continue
                owner = owner_from_home(parts[1].strip()) or account
                if not owner:
                    continue
                ports = published_ports(parts[2])
                if ports:
                    container_ports.append((ports, owner))
        elif err:
            docker_error(errors, "docker ps", err, account)
    return container_ports


def with_container_owners(owners: dict, container_ports: list):
    for ports, owner in container_ports:
        for port in ports:
            owners[port] = owner
    return [{"port": port, "owner": owners[port]} for port in sorted(owners)]


def read_ports(errors: list):
    """Container owner wins over the process holding the port: what listens
    for a published port is Docker's own proxy, which belongs to root and
    would hide nothing."""
    container_ports = container_published_ports(errors)

    ok, out, err = run(["ps", "-eo", "pid=,user="])
    user_of_pid = {}
    if err:
        errors.append("ps: %s" % err)
    elif ok:
        for line in out.splitlines():
            fields = line.split()
            if len(fields) < 2:
                continue
            try:
                user_of_pid[int(fields[0])] = fields[1]
            except ValueError:
                continue

    ok, out, err = run(["ss", "-lntpH"])
    if err:
        errors.append("ss: %s" % err)
        return []
    if not ok:
        errors.append("ss: not found")
        return []

    owners: dict = {}
    for line in out.splitlines():
        port = listening_port(line)
        if port is None:
            continue
        pid = first_pid(line)
        user = user_of_pid.get(pid) if pid is not None else None
        if port not in owners:
            owners[port] = user

    return with_container_owners(owners, container_ports)


def port_of_address(address: str):
    """`*:22`, `127.0.0.1:5432`, `[::1]:5432` -> the port."""
    try:
        return int(address.rsplit(":", 1)[1])
    except (IndexError, ValueError):
        return None


def read_ports_darwin(errors: list, endpoints: list | None = None):
    """macOS has no `ss`: `lsof` names the listening sockets and, in its
    field output, the login of each process. lsof exits 1 when nothing
    listens, which is an empty list, not an error."""
    container_ports = container_published_ports(errors, endpoints or docker_endpoints("Darwin"))

    ok, out, _ = run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN", "-FpLn"])
    owners: dict = {}
    if ok:
        user = None
        for line in out.splitlines():
            tag, value = line[:1], line[1:]
            if tag == "p":
                user = None
            elif tag == "L":
                user = value or None
            elif tag == "n":
                port = port_of_address(value)
                if port is not None and port not in owners:
                    owners[port] = user

    return with_container_owners(owners, container_ports)


# ── main ─────────────────────────────────────────────────────────────────

def collect(system: str | None = None) -> dict:
    darwin = (system or platform.system()) == "Darwin"
    endpoints = docker_endpoints("Darwin" if darwin else "Linux")
    errors: list = []
    if darwin:
        memory, swap = read_memory_and_swap_darwin(errors)
    else:
        memory, swap = read_memory_and_swap(errors)
    return {
        "collected_at": datetime.now(timezone.utc).isoformat(),
        "memory": memory,
        "swap": swap,
        "disk": read_disk_darwin(errors) if darwin else read_disk(errors),
        "load": read_load_darwin(errors) if darwin else read_load(errors),
        "docker": read_docker(errors, endpoints),
        "users": read_users(errors),
        "ports": read_ports_darwin(errors, endpoints) if darwin else read_ports(errors),
        "errors": errors,
    }


def main():
    print(json.dumps(collect(), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
