#!/usr/bin/env python3
"""devmachine-caddy-logs: the tail of Caddy's own journal.

Usage:
    devmachine-caddy-logs [--lines N]

Runs `journalctl -u caddy -n N --no-pager` on the machine and prints its
output verbatim — the same read the Devmachine macOS app used to send as raw
shell over SSH. A Mac has no journal: there it prints the last N lines of the
log the caddy package writes. Prints plain text, not JSON: a log is read, not
parsed.
"""
from __future__ import annotations

import argparse
import platform
import subprocess
import sys
from collections import deque
from pathlib import Path

DARWIN_LOG = Path("/var/log/devmachine-caddy.log")
# What Caddy prints before its own logging is configured, such as a Caddyfile
# it cannot load.
DARWIN_LAUNCHD_LOG = Path("/var/log/devmachine-caddy.launchd.log")
NO_ENTRIES = "-- No entries --\n"


def tail(path: Path, lines: int) -> str:
    with path.open(encoding="utf-8", errors="replace") as f:
        return "".join(deque(f, maxlen=lines))


def mtime(path: Path):
    try:
        return path.stat().st_mtime
    except FileNotFoundError:
        return None


def failed_to_start(startup: str) -> bool:
    """Caddy's last word before it exits on a bad start is `Error: ...`."""
    last = [line for line in startup.splitlines() if line.strip()][-1:]
    return bool(last) and last[0].startswith("Error:")


def darwin_logs(lines: int) -> int:
    """The tail of Caddy's own log. Its startup output wins only when Caddy
    never opened that log, or when it is newer and ends in the error Caddy
    exits with: a start that fails leaves the older log behind untouched.
    Neither file is a machine without Caddy."""
    try:
        log_time, startup_time = mtime(DARWIN_LOG), mtime(DARWIN_LAUNCHD_LOG)
        startup = tail(DARWIN_LAUNCHD_LOG, lines) if startup_time is not None else ""
        if log_time is None or (startup and startup_time > log_time and failed_to_start(startup)):
            text = startup
        else:
            text = tail(DARWIN_LOG, lines)
    except OSError as e:
        print("%s: %s" % (e.filename or "caddy log", e.strerror or e), file=sys.stderr)
        return 1
    if not text:
        sys.stdout.write(NO_ENTRIES)
    else:
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--lines", type=int, default=200, help="how many lines to print (default 200)")
    args = ap.parse_args()

    if args.lines <= 0:
        ap.error("--lines must be a positive number")

    if platform.system() == "Darwin":
        return darwin_logs(args.lines)

    try:
        result = subprocess.run(
            ["journalctl", "-u", "caddy", "-n", str(args.lines), "--no-pager"],
            capture_output=True,
            text=True,
            timeout=15,
        )
    except FileNotFoundError:
        print("journalctl: not found", file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired:
        print("journalctl: timed out", file=sys.stderr)
        return 1

    if result.returncode != 0:
        print(result.stderr.strip() or "journalctl: exit %d" % result.returncode, file=sys.stderr)
        return 1

    sys.stdout.write(result.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
