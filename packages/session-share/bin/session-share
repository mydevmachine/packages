#!/usr/bin/env python3
"""Runs the account's session-share binary, reached through `devmachine run --package session-share`."""
import os
import sys

COMMANDS = {
    "start": ["start"],
    "stop": ["stop"],
    "extend": ["extend"],
    "list": ["list"],
    "logs": ["logs"],
    "expose": ["expose"],
    "shares": ["list", "--all", "--json"],
}


def binary():
    return os.path.join(os.path.expanduser("~"), ".local", "bin", "session-share")


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(f"usage: session-share {{{','.join(COMMANDS)}}} [args...]", file=sys.stderr)
        return 2
    path = binary()
    if not os.access(path, os.X_OK):
        print(f"session-share is not installed for this account ({path}): add the package to this workspace and sync", file=sys.stderr)
        return 1
    os.execv(path, [path, *COMMANDS[argv[0]], *argv[1:]])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
