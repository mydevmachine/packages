#!/usr/bin/env python3
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_BASE = "https://api.cloudflare.com/client/v4"
PER_PAGE = "100"

# Cloudflare keeps an MX priority in its own field and SRV and CAA parts in a
# "data" object; the contract writes all of them inside one value string, the
# way a zone file does, so this file joins and splits them.
SUPPORTED_TYPES = {"A", "AAAA", "CNAME", "TXT", "MX", "SRV", "NS", "CAA"}


def fail(kind, message):
    print(json.dumps({"error": {"kind": kind, "message": message}}))
    sys.exit(1)


def base_url():
    return os.environ.get("DEVMACHINE_DNS_BASE", DEFAULT_BASE)


def token():
    value = os.environ.get("CLOUDFLARE_API_TOKEN", "")
    if not value:
        fail("unauthenticated", "CLOUDFLARE_API_TOKEN is not set")
    return value


def message_from(envelope, fallback):
    errors = envelope.get("errors") or []
    if errors:
        return "; ".join(e.get("message", fallback) for e in errors)
    return fallback


def call(method, path, body=None):
    url = base_url() + path
    data = json.dumps(body).encode() if body is not None else None
    request = urllib.request.Request(url, data=data, method=method)
    request.add_header("Authorization", "Bearer " + token())
    request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request) as response:
            status = response.status
            raw = response.read()
    except urllib.error.HTTPError as error:
        status = error.code
        raw = error.read()

    try:
        envelope = json.loads(raw) if raw else {}
    except json.JSONDecodeError:
        envelope = {}

    if status == 429:
        fail("rate_limited", "cloudflare is throttling this token")
    if status == 401:
        fail("unauthenticated", message_from(envelope, "the token was rejected"))
    if status == 403:
        fail("forbidden", message_from(envelope, "the token cannot change this zone"))

    # Cloudflare's v4 envelope is the source of truth, not the HTTP status:
    # a general failure can still arrive with a 200.
    if not envelope.get("success", False):
        fail("invalid_record", message_from(envelope, "request failed"))

    return envelope


def zone_id(zone):
    query = urllib.parse.urlencode({"name": zone, "per_page": PER_PAGE})
    envelope = call("GET", "/zones?" + query)
    result = envelope.get("result") or []
    if not result:
        # A name with no matching zone is a 200 with an empty result, not a 404.
        fail("zone_not_found", "no zone named %r on this account, or the token cannot see it" % zone)
    return result[0]["id"]


def list_records(zid, record_type=None, name=None):
    params = {"per_page": PER_PAGE}
    if record_type:
        params["type"] = record_type
    if name:
        params["name.exact"] = name
    query = urllib.parse.urlencode(params)
    envelope = call("GET", "/zones/%s/dns_records?%s" % (zid, query))
    return envelope.get("result") or []


def full_name(zone, label):
    if label == "@":
        return zone
    return "%s.%s" % (label, zone)


def label_from_full(zone, full):
    if full == zone:
        return "@"
    suffix = "." + zone
    if full.endswith(suffix):
        return full[: -len(suffix)]
    return full


def host(name):
    return str(name).rstrip(".").lower()


def value_of(record):
    record_type = record["type"]
    data = record.get("data") or {}
    if record_type == "MX":
        return "%s %s" % (record.get("priority", 0), host(record.get("content", "")))
    if record_type == "SRV" and data:
        return "%s %s %s %s" % (data.get("priority", 0), data.get("weight", 0), data.get("port", 0), host(data.get("target", "")))
    if record_type == "CAA" and data:
        return '%s %s "%s"' % (data.get("flags", 0), data.get("tag", ""), data.get("value", ""))
    if record_type in ("CNAME", "NS"):
        return host(record.get("content", ""))
    return record.get("content", "")


def number(field, value):
    try:
        return int(field)
    except ValueError:
        fail("invalid_record", "%r in %r is not a number" % (field, value))


def fields_for(record_type, value):
    parts = value.split()
    if record_type == "MX":
        if len(parts) != 2:
            fail("invalid_record", "an MX value is '<priority> <host>', got %r" % value)
        return {"content": host(parts[1]), "priority": number(parts[0], value)}
    if record_type == "SRV":
        if len(parts) != 4:
            fail("invalid_record", "an SRV value is '<priority> <weight> <port> <target>', got %r" % value)
        return {"data": {"priority": number(parts[0], value), "weight": number(parts[1], value),
                         "port": number(parts[2], value), "target": host(parts[3])}}
    if record_type == "CAA":
        if len(parts) < 3:
            fail("invalid_record", "a CAA value is '<flags> <tag> <value>', got %r" % value)
        return {"data": {"flags": number(parts[0], value), "tag": parts[1].lower(), "value": " ".join(parts[2:]).strip('"')}}
    return {"content": value}


def same_value(record_type, record, value):
    return value_of(record) == value_of(dict(fields_for(record_type, value), type=record_type))


def cmd_list(zone):
    zid = zone_id(zone)
    records = list_records(zid)
    out = []
    for record in records:
        if record["type"] not in SUPPORTED_TYPES:
            continue
        out.append(
            {
                "name": label_from_full(zone, record["name"]),
                "type": record["type"],
                "value": value_of(record),
                "ttl": record["ttl"],
            }
        )
    print(json.dumps({"records": out}))


def cloudflare_ttl(ttl):
    # 0 means "choose": Cloudflare's own choice is ttl 1, "automatic".
    return 1 if not ttl else ttl


def cmd_upsert(zone, record):
    name = record["name"]
    record_type = record["type"]
    value = record["value"]
    ttl = cloudflare_ttl(record.get("ttl") or 0)

    full = full_name(zone, name)
    zid = zone_id(zone)
    matches = list_records(zid, record_type=record_type, name=full)

    if not matches:
        create(zid, record_type, full, value, ttl)
        print(json.dumps({}))
        return

    if len(matches) > 1:
        fail(
            "ambiguous",
            "%s %s has %d values; refusing to guess which one to change" % (full, record_type, len(matches)),
        )

    current = matches[0]
    if same_value(record_type, current, value) and current["ttl"] == ttl:
        print(json.dumps({}))
        return

    # PATCH, never PUT: a PUT that omits proxied, ttl, comment or tags resets
    # them to defaults, so changing an address would silently clear the rest.
    call("PATCH", "/zones/%s/dns_records/%s" % (zid, current["id"]), dict(fields_for(record_type, value), ttl=ttl))
    print(json.dumps({}))


def create(zid, record_type, full, value, ttl):
    body = {"type": record_type, "name": full, "ttl": ttl, "proxied": False}
    body.update(fields_for(record_type, value))
    call("POST", "/zones/%s/dns_records" % zid, body)


def cmd_append(zone, record):
    name = record["name"]
    record_type = record["type"]
    value = record["value"]
    ttl = cloudflare_ttl(record.get("ttl") or 0)

    full = full_name(zone, name)
    zid = zone_id(zone)
    matches = list_records(zid, record_type=record_type, name=full)

    if any(same_value(record_type, m, value) for m in matches):
        print(json.dumps({}))
        return

    # Every value at a Cloudflare name is its own record, so adding one is a
    # create, and the others are never touched.
    create(zid, record_type, full, value, ttl)
    print(json.dumps({}))


def cmd_delete(zone, record):
    name = record["name"]
    record_type = record["type"]
    value = record.get("value", "")

    full = full_name(zone, name)
    zid = zone_id(zone)
    matches = list_records(zid, record_type=record_type, name=full)

    if not value:
        for match in matches:
            call("DELETE", "/zones/%s/dns_records/%s" % (zid, match["id"]))
        print(json.dumps({}))
        return

    target = next((m for m in matches if same_value(record_type, m, value)), None)
    if target is None:
        print(json.dumps({}))
        return

    call("DELETE", "/zones/%s/dns_records/%s" % (zid, target["id"]))
    print(json.dumps({}))


def cmd_zones():
    # per_page because v4 pages at a size it does not document, so the default
    # would silently hide zones on an account with many of them.
    envelope = call("GET", "/zones?per_page=50")
    print(json.dumps({"zones": [z["name"] for z in envelope.get("result") or []]}))


COMMANDS = [
    {"name": "zones", "summary": "The zones this token can see."},
    {"name": "list", "summary": "Every record in a zone.", "args": "<zone>"},
    {"name": "upsert", "summary": "Make a name hold exactly one value.", "args": "<zone>"},
    {"name": "append", "summary": "Add one value next to the ones a name holds.", "args": "<zone>"},
    {"name": "delete", "summary": "Remove one value from a name.", "args": "<zone>"},
    {"name": "help", "summary": "This list."},
]


def cmd_help():
    print(json.dumps({"commands": COMMANDS}))


def read_record():
    raw = sys.stdin.read()
    try:
        return json.loads(raw)
    except json.JSONDecodeError:
        fail("invalid_record", "stdin is not valid JSON")


def main(argv):
    if len(argv) < 2:
        fail("invalid_record", "usage: provider zones|list|upsert|append|delete|help [<zone>]")

    command = argv[1]

    if command == "zones":
        cmd_zones()
        return

    if command == "help":
        cmd_help()
        return

    if len(argv) < 3:
        fail("invalid_record", "usage: provider %s <zone>" % command)
    zone = argv[2]

    if command == "list":
        cmd_list(zone)
        return

    if command == "upsert":
        cmd_upsert(zone, read_record())
        return

    if command == "append":
        cmd_append(zone, read_record())
        return

    if command == "delete":
        cmd_delete(zone, read_record())
        return

    fail("invalid_record", "unknown command " + repr(command))


if __name__ == "__main__":
    main(sys.argv)
