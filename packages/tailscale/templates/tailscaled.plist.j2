<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>{{ devmachine_tailscale_label }}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ devmachine_tailscale_brew_prefix }}/opt/tailscale/bin/tailscaled</string>
    <string>--state=/var/lib/tailscale/tailscaled.state</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
